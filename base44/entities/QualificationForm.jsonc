{
  "name": "QualificationForm",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "field_type": {
            "type": "string",
            "enum": [
              "text",
              "multiple_choice",
              "yes_no",
              "numeric",
              "date_time",
              "budget",
              "geographic"
            ],
            "default": "text"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "customer_facing": {
            "type": "boolean",
            "default": true
          },
          "internal_only": {
            "type": "boolean",
            "default": false
          },
          "conditional_on": {
            "type": "string"
          },
          "conditional_value": {
            "type": "string"
          },
          "score_weight": {
            "type": "number",
            "default": 0
          },
          "disclosure": {
            "type": "string"
          }
        }
      }
    },
    "qualification_threshold": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ],
      "default": "draft"
    }
  },
  "required": [
    "organization_id",
    "brand_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                },
                {
                  "data.brand_id": {
                    "$in": "{{user.data.assigned_brand_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}