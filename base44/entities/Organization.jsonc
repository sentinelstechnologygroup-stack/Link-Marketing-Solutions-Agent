{
  "name": "Organization",
  "type": "object",
  "properties": {
    "legal_name": {
      "type": "string",
      "description": "Legal entity name"
    },
    "display_name": {
      "type": "string",
      "description": "Friendly display name"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string",
      "format": "email"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "business_hours_start": {
      "type": "string",
      "description": "HH:mm 24h"
    },
    "business_hours_end": {
      "type": "string",
      "description": "HH:mm 24h"
    },
    "consent_language_version": {
      "type": "string",
      "default": "1.0"
    },
    "recording_retention_days": {
      "type": "number",
      "default": 365
    },
    "data_retention_days": {
      "type": "number",
      "default": 1095
    }
  },
  "required": [
    "legal_name",
    "display_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "id": "{{user.data.organization_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "org_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}