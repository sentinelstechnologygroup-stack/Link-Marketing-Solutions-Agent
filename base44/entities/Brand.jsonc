{
  "name": "Brand",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Owning organization"
    },
    "legal_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "caller_id_display_name": {
      "type": "string"
    },
    "default_greeting": {
      "type": "string",
      "description": "Required agent greeting for inbound/outbound"
    },
    "after_hours_greeting": {
      "type": "string"
    },
    "business_hours_start": {
      "type": "string"
    },
    "business_hours_end": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "after_hours_rule": {
      "type": "string",
      "enum": [
        "voicemail",
        "callback_request",
        "overflow_queue"
      ],
      "default": "voicemail"
    },
    "consent_language": {
      "type": "string"
    },
    "opt_out_procedure": {
      "type": "string"
    },
    "recording_retention_days": {
      "type": "number",
      "default": 365
    },
    "appointment_buffer_minutes": {
      "type": "number",
      "default": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "organization_id",
    "display_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                },
                {
                  "id": {
                    "$in": "{{user.data.assigned_brand_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "user_condition": {
                "role": "org_admin"
              }
            }
          ]
        }
      ]
    }
  }
}