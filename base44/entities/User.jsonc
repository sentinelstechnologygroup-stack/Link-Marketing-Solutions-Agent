{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "org_admin",
        "brand_admin",
        "supervisor",
        "lead_response_agent",
        "business_owner",
        "realtor",
        "reporting_only",
        "auditor",
        "disabled"
      ],
      "default": "lead_response_agent"
    },
    "organization_id": {
      "type": "string",
      "description": "Primary organization assignment"
    },
    "assigned_brand_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Brands this user may access"
    },
    "assigned_campaign_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_status": {
      "type": "string",
      "enum": [
        "offline",
        "available",
        "on_call",
        "break",
        "callback_only",
        "training",
        "temporarily_unavailable",
        "suspended"
      ],
      "default": "offline"
    },
    "coverage_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "default": "America/Chicago"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidentiality_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "data_privacy_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "mfa_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_login_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "role"
  ]
}