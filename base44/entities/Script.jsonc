{
  "name": "Script",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "callback",
        "warm_transfer",
        "appointment_confirm"
      ],
      "default": "outbound"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "retired"
      ],
      "default": "draft"
    },
    "opening_statement": {
      "type": "string"
    },
    "qualification_questions": {
      "type": "string"
    },
    "objection_responses": {
      "type": "string"
    },
    "transfer_language": {
      "type": "string"
    },
    "appointment_language": {
      "type": "string"
    },
    "opt_out_language": {
      "type": "string"
    },
    "escalation_instructions": {
      "type": "string"
    },
    "assigned_agent_roles": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "parent_script_id": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "brand_id",
    "name",
    "version_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                },
                {
                  "data.brand_id": {
                    "$in": "{{user.data.assigned_brand_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.data.organization_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "org_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "brand_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}